                                <span>Web Developer, Tech Startup</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Testimonial 2 -->
                    <div class="testimonial-card">
                        <div class="testimonial-stars">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <p class="testimonial-text">
                            "I gained practical skills that I still use today. The instructor was patient and made sure everyone understood before moving forward."
                        </p>
                        <div class="testimonial-author">
                            <img src="https://ui-avatars.com/api/?name=Jane+Smith&background=0056D2&color=fff" alt="Student" />
                            <div>
                                <h4>Jane Smith</h4>
                                <span>WordPress Developer</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Testimonial 3 -->
                    <div class="testimonial-card">
                        <div class="testimonial-stars">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
