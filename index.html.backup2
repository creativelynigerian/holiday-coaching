    <!-- Application Form Section -->
    <section id="apply" class="apply section-padding">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Apply Now</span>
                <h2 class="section-title">Secure Your <span class="gradient-text">Spot</span></h2>
                <p class="section-subtitle">Register now for the Holiday IT Coaching 2026 program</p>
            </div>
            
            <div class="form-container">
                <form id="applicationForm" novalidate>
                    <!-- Personal Information -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="fas fa-user"></i> Personal Information
                        </h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="fullName">Full Name *</label>
                                <input type="text" id="fullName" name="fullName" required placeholder="Enter your full name" />
                                <div class="error-message"></div>
                            </div>
                            <div class="form-group">
                                <label for="email">Email Address *</label>
                                <input type="email" id="email" name="email" required placeholder="Enter your email" />
                                <div class="error-message"></div>
                            </div>
                            <div class="form-group">
                                <label for="phone">Phone Number *</label>
                                <input type="tel" id="phone" name="phone" required placeholder="Enter your phone number" />
                                <div class="error-message"></div>
                            </div>
                            <div class="form-group">
                                <label for="dateOfBirth">Date of Birth</label>
                                <input type="date" id="dateOfBirth" name="dateOfBirth" />
                            </div>
                            <div class="form-group">
                                <label for="gender">Gender</label>
                                <select id="gender" name="gender">
                                    <option value="">Select gender</option>
                                    <option value="male">Male</option>
                                    <option value="female">Female</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="address">Home Address</label>
                                <input type="text" id="address" name="address" placeholder="Enter your address" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Guardian Information -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="fas fa-users"></i> Guardian Information
                        </h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="guardianName">Guardian's Full Name</label>
                                <input type="text" id="guardianName" name="guardianName" placeholder="Enter guardian's name" />
                            </div>
                            <div class="form-group">
                                <label for="guardianPhone">Guardian's Phone</label>
                                <input type="tel" id="guardianPhone" name="guardianPhone" placeholder="Enter guardian's phone" />
                            </div>
                            <div class="form-group">
                                <label for="guardianEmail">Guardian's Email</label>
                                <input type="email" id="guardianEmail" name="guardianEmail" placeholder="Enter guardian's email" />
                            </div>
                            <div class="form-group">
                                <label for="guardianRelation">Relationship</label>
                                <select id="guardianRelation" name="guardianRelation">
                                    <option value="">Select relationship</option>
                                    <option value="parent">Parent</option>
                                    <option value="sibling">Sibling</option>
                                    <option value="relative">Relative</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Educational Background -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="fas fa-graduation-cap"></i> Educational Background
                        </h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="educationLevel">Highest Education Level</label>
                                <select id="educationLevel" name="educationLevel">
                                    <option value="">Select level</option>
                                    <option value="ssce">SSCE</option>
                                    <option value="diploma">Diploma</option>
                                    <option value="bachelor">Bachelor's Degree</option>
                                    <option value="master">Master's Degree</option>
                                    <option value="phd">PhD</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="institution">Institution Name</label>
                                <input type="text" id="institution" name="institution" placeholder="Enter institution name" />
                            </div>
                            <div class="form-group">
                                <label for="studyField">Field of Study</label>
                                <input type="text" id="studyField" name="studyField" placeholder="Enter field of study" />
                            </div>
                            <div class="form-group">
                                <label for="gradYear">Graduation Year</label>
                                <input type="number" id="gradYear" name="gradYear" placeholder="YYYY" min="2000" max="2030" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Course Interests -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="fas fa-code"></i> Course Interests
                        </h3>
                        <div class="checkbox-grid">
                            <label class="checkbox-label">
                                <input type="checkbox" name="interests" value="web-development" />
                                <span>Web Development</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="interests" value="wordpress" />
                                <span>WordPress</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="interests" value="react" />
                                <span>React</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="interests" value="javascript" />
                                <span>JavaScript</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="interests" value="moodle" />
                                <span>Moodle LMS</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="interests" value="ai-tools" />
                                <span>AI Tools</span>
                            </label>
                        </div>
                    </div>
                    
                    <!-- Laptop Ownership & Computer Knowledge -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="fas fa-laptop"></i> Laptop & Computer Knowledge
                        </h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="laptopOwnership">Do you own a laptop?</label>
                                <select id="laptopOwnership" name="laptopOwnership">
                                    <option value="">Select option</option>
                                    <option value="yes">Yes</option>
                                    <option value="no">No</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="computerKnowledge">Previous Computer Knowledge</label>
                                <select id="computerKnowledge" name="computerKnowledge">
                                    <option value="">Select level</option>
                                    <option value="none">None</option>
                                    <option value="basic">Basic</option>
                                    <option value="intermediate">Intermediate</option>
                                    <option value="advanced">Advanced</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Emergency Contact -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <i class="fas fa-phone-alt"></i> Emergency Contact
                        </h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="emergencyName">Emergency Contact Name</label>
                                <input type="text" id="emergencyName" name="emergencyName" placeholder="Enter emergency contact name" />
                            </div>
                            <div class="form-group">
                                <label for="emergencyPhone">Emergency Contact Phone</label>
                                <input type="tel" id="emergencyPhone" name="emergencyPhone" placeholder="Enter emergency contact phone" />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Declaration -->
                    <div class="form-section">
                        <label class="checkbox-label declaration">
                            <input type="checkbox" id="declaration" name="declaration" required />
                            <span>
                                I hereby declare that all information provided is true and accurate. I agree to abide by the 
                                rules and regulations of the training program.
                            </span>
                        </label>
                        <div class="error-message"></div>
                    </div>
                    
                    <!-- Submit -->
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary btn-large submit-btn">
                            <i class="fas fa-paper-plane"></i> Submit Application
                        </button>
                        <div class="form-loader" style="display: none;">
                            <i class="fas fa-spinner fa-spin"></i> Submitting...
                        </div>
                    </div>
                </form>
                
                <!-- Success Message -->
                <div id="successMessage" class="success-message" style="display: none;">
                    <i class="fas fa-check-circle"></i>
                    <h3>Application Submitted!</h3>
                    <p>Thank you for applying to the Holiday IT Coaching 2026 program.</p>
                    <p>You will receive a confirmation email shortly.</p>
                    <button class="btn btn-primary" onclick="location.reload()">Submit Another</button>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="faq section-padding" style="background: var(--light);">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">FAQ</span>
                <h2 class="section-title">Frequently Asked <span class="gradient-text">Questions</span></h2>
                <p class="section-subtitle">Everything you need to know about the program</p>
            </div>
            
            <div class="faq-grid">
                <div class="faq-item">
                    <div class="faq-question">
                        <h3>What are the requirements to join?</h3>
                        <span class="faq-toggle"><i class="fas fa-plus"></i></span>
                    </div>
                    <div class="faq-answer">
                        <p>Basic computer literacy is recommended. You should have access to a laptop and a stable internet connection. No prior coding experience is required - we start from the basics!</p>
                    </div>
                </div>
                
                <div class="faq-item">
                    <div class="faq-question">
                        <h3>How long is the training program?</h3>
                        <span class="faq-toggle"><i class="fas fa-plus"></i></span>
                    </div>
                    <div class="faq-answer">
                        <p>The program runs for 3 weeks (15 days) with intensive hands-on training sessions. Each day includes both theoretical lessons and practical projects.</p>
                    </div>
                </div>
                
                <div class="faq-item">
                    <div class="faq-question">
                        <h3>Will I receive a certificate?</h3>
                        <span class="faq-toggle"><i class="fas fa-plus"></i></span>
                    </div>
                    <div class="faq-answer">
                        <p>Yes, all participants who complete the program will receive a certificate of completion from CCYI Global Enterprise, recognized by employers.</p>
                    </div>
                </div>
                
                <div class="faq-item">
                    <div class="faq-question">
                        <h3>Is this program suitable for beginners?</h3>
                        <span class="faq-toggle"><i class="fas fa-plus"></i></span>
                    </div>
                    <div class="faq-answer">
                        <p>Absolutely! The program is designed for beginners and progresses to advanced topics. No prior experience is needed.</p>
                    </div>
                </div>
                
                <div class="faq-item">
                    <div class="faq-question">
                        <h3>What is the cost of the program?</h3>
                        <span class="faq-toggle"><i class="fas fa-plus"></i></span>
                    </div>
                    <div class="faq-answer">
                        <p>Please contact us directly or WhatsApp us for current pricing and available payment plans. We offer flexible payment options to suit your budget.</p>
                    </div>
                </div>
                
                <div class="faq-item">
                    <div class="faq-question">
                        <h3>What happens after the training?</h3>
                        <span class="faq-toggle"><i class="fas fa-plus"></i></span>
                    </div>
                    <div class="faq-answer">
                        <p>You'll have a portfolio of projects to showcase to employers. We also provide career guidance and job placement assistance to help you start your career.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

