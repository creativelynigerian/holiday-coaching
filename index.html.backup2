<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Holiday IT Coaching 2026 - Acquire practical digital skills before university admission. Learn from industry experts and become job-ready in just 3 weeks." />
    <meta name="keywords" content="IT coaching, holiday training, web development, WordPress, React, JavaScript, CCYI" />
    <meta name="author" content="CCYI Global Enterprise" />
    
    <!-- Open Graph Tags -->
    <meta property="og:title" content="Holiday IT Coaching 2026 | CCYI Global Enterprise" />
    <meta property="og:description" content="Acquire practical digital skills before university admission. Learn from industry experts and become job-ready in just 3 weeks." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://holiday-it-coaching.vercel.app" />
    <meta property="og:image" content="https://holiday-it-coaching.vercel.app/images/hero.jpg" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/animations.css" />
    <link rel="stylesheet" href="css/responsive.css" />
</head>
<body>
    <!-- Loading Screen -->
    <div id="loading-screen">
        <div class="loader">
            <div class="loader-ring"></div>
            <div class="loader-ring"></div>
            <div class="loader-ring"></div>
            <p class="loader-text">Loading...</p>
        </div>
    </div>

    <!-- Progress Bar -->
    <div id="progress-bar"></div>

    <!-- Navigation -->
    <nav id="navbar" class="navbar">
        <div class="container">
            <div class="nav-wrapper">
                <div class="nav-brand">
                    <img src="images/ccyi-logo.png" alt="CCYI Logo" class="logo-img" />
                    <span class="brand-text">CCYI<span class="highlight">Global</span></span>
                </div>
                
                <button class="nav-toggle" aria-label="Toggle navigation">
                    <span class="hamburger"></span>
                    <span class="hamburger"></span>
                    <span class="hamburger"></span>
                </button>
                
                <ul class="nav-menu">
                    <li><a href="#home" class="nav-link active">Home</a></li>
                    <li><a href="#about" class="nav-link">About</a></li>
                    <li><a href="#curriculum" class="nav-link">Curriculum</a></li>
                    <li><a href="#instructor" class="nav-link">Instructor</a></li>
                    <li><a href="#testimonials" class="nav-link">Testimonials</a></li>
                    <li><a href="#faq" class="nav-link">FAQ</a></li>
                    <li><a href="#contact" class="nav-link">Contact</a></li>
                    <li><a href="#apply" class="btn btn-primary nav-cta">Apply Now</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="container">
            <div class="hero-grid">
                <div class="hero-content">
                    <span class="hero-badge">2026 Cohort</span>
                    <h1 class="hero-title">
                        Holiday IT Coaching
                        <span class="gradient-text">2026</span>
                    </h1>
                    <p class="hero-subtitle">
                        Acquire Practical Digital Skills Before University Admission
                    </p>
                    <p class="hero-description">
                        Learn from industry experts and become job-ready in just 
                        <span class="highlight-text">3 Weeks</span>.
                    </p>
                    
                    <div class="hero-buttons">
                        <a href="#apply" class="btn btn-primary btn-large">
                            <i class="fas fa-paper-plane"></i> Apply Now
                        </a>
                        <a href="#" class="btn btn-outline btn-large">
                            <i class="fas fa-download"></i> Brochure
                        </a>
                        <a href="https://wa.me/2348000000000" target="_blank" class="btn btn-success btn-large">
                            <i class="fab fa-whatsapp"></i> WhatsApp
                        </a>
                    </div>
                    
                    <div class="hero-stats">
                        <div class="stat-item">
                            <span class="stat-number" data-count="500">0</span>
                            <span class="stat-label">Students Trained</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number" data-count="100">0</span>
                            <span class="stat-label">Websites Built</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number" data-count="15">0</span>
                            <span class="stat-label">Industry Projects</span>
                        </div>
                    </div>
                </div>
                
                <div class="hero-image">
                    <img src="images/hero.jpg" alt="IT Coaching Banner" />
                    <div class="floating-card card-1">
                        <i class="fas fa-code"></i>
                        <span>HTML5</span>
                    </div>
                    <div class="floating-card card-2">
                        <i class="fab fa-react"></i>
                        <span>React</span>
                    </div>
                    <div class="floating-card card-3">
                        <i class="fab fa-wordpress"></i>
                        <span>WordPress</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Scroll Indicator -->
        <div class="scroll-indicator">
            <span>Scroll</span>
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about section-padding">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Why Join?</span>
                <h2 class="section-title">Transform Your <span class="gradient-text">Future</span></h2>
                <p class="section-subtitle">Gain the digital skills that employers demand</p>
            </div>
            
            <div class="about-grid">
                <div class="about-card">
                    <div class="about-icon">
                        <i class="fas fa-laptop-code"></i>
                    </div>
                    <h3>Website Development</h3>
                    <p>Build professional websites from scratch using modern technologies and best practices.</p>
                </div>
                
                <div class="about-card">
                    <div class="about-icon">
                        <i class="fab fa-wordpress"></i>
                    </div>
                    <h3>WordPress CMS</h3>
                    <p>Master the world's most popular content management system for building dynamic websites.</p>
                </div>
                
                <div class="about-card">
                    <div class="about-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h3>Moodle LMS</h3>
                    <p>Learn to manage online learning platforms and create engaging educational experiences.</p>
                </div>
                
                <div class="about-card">
                    <div class="about-icon">
                        <i class="fab fa-html5"></i>
                    </div>
                    <h3>HTML5 & CSS3</h3>
                    <p>Structure and style web content with the latest standards for responsive design.</p>
                </div>
                
                <div class="about-card">
                    <div class="about-icon">
                        <i class="fab fa-js"></i>
                    </div>
                    <h3>JavaScript</h3>
                    <p>Add interactivity and dynamic functionality to websites with modern JavaScript.</p>
                </div>
                
                <div class="about-card">
                    <div class="about-icon">
                        <i class="fab fa-react"></i>
                    </div>
                    <h3>React</h3>
                    <p>Build powerful, component-based user interfaces with the most popular frontend framework.</p>
                </div>
                
                <div class="about-card">
                    <div class="about-icon">
                        <i class="fab fa-git-alt"></i>
                    </div>
                    <h3>Git & GitHub</h3>
                    <p>Master version control and collaborate effectively on software projects.</p>
                </div>
                
                <div class="about-card">
                    <div class="about-icon">
                        <i class="fas fa-brain"></i>
                    </div>
                    <h3>AI Tools</h3>
                    <p>Leverage artificial intelligence to boost productivity and enhance your workflow.</p>
                </div>
                
                <div class="about-card highlight-card">
                    <div class="about-icon">
                        <i class="fas fa-certificate"></i>
                    </div>
                    <h3>Certificate</h3>
                    <p>Earn a recognized certificate upon completion to boost your CV and career prospects.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Curriculum Section -->
    <section id="curriculum" class="curriculum section-padding">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Curriculum</span>
                <h2 class="section-title">What You'll <span class="gradient-text">Learn</span></h2>
                <p class="section-subtitle">A comprehensive 3-week journey from beginner to job-ready</p>
            </div>
            
            <div class="curriculum-timeline">
                <!-- Week 1 -->
                <div class="timeline-item">
                    <div class="timeline-badge">Week 1</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3>Foundations</h3>
                            <span class="timeline-date">Days 1-5</span>
                        </div>
                        <div class="timeline-body">
                            <div class="skill-tag">
                                <i class="fas fa-microchip"></i> Computer Fundamentals
                            </div>
                            <div class="skill-tag">
                                <i class="fab fa-html5"></i> HTML5
                            </div>
                            <div class="skill-tag">
                                <i class="fab fa-css3-alt"></i> CSS3
                            </div>
                        </div>
                        <p class="timeline-description">
                            Build a strong foundation in computing principles, structure web content with HTML, and style it beautifully with CSS.
                        </p>
                    </div>
                </div>
                
                <!-- Week 2 -->
                <div class="timeline-item">
                    <div class="timeline-badge">Week 2</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3>Interactive Development</h3>
                            <span class="timeline-date">Days 6-10</span>
                        </div>
                        <div class="timeline-body">
                            <div class="skill-tag">
                                <i class="fab fa-js"></i> JavaScript
                            </div>
                            <div class="skill-tag">
                                <i class="fab fa-git-alt"></i> Git
                            </div>
                            <div class="skill-tag">
                                <i class="fab fa-github"></i> GitHub
                            </div>
                            <div class="skill-tag">
                                <i class="fas fa-code"></i> VS Code
                            </div>
                        </div>
                        <p class="timeline-description">
                            Master JavaScript programming, version control with Git, and efficient development using VS Code.
                        </p>
                    </div>
                </div>
                
                <!-- Week 3 -->
                <div class="timeline-item">
                    <div class="timeline-badge">Week 3</div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3>Advanced & Deployment</h3>
                            <span class="timeline-date">Days 11-15</span>
                        </div>
                        <div class="timeline-body">
                            <div class="skill-tag">
                                <i class="fab fa-react"></i> React
                            </div>
                            <div class="skill-tag">
                                <i class="fab fa-wordpress"></i> WordPress
                            </div>
                            <div class="skill-tag">
                                <i class="fas fa-graduation-cap"></i> Moodle LMS
                            </div>
                            <div class="skill-tag">
                                <i class="fas fa-rocket"></i> Project Deployment
                            </div>
                        </div>
                        <p class="timeline-description">
                            Build interactive UIs with React, manage content with WordPress, create learning platforms with Moodle, and deploy projects to the web.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us Section -->
    <section class="why-choose section-padding" style="background: var(--light);">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Why CCYI</span>
                <h2 class="section-title">Why Choose <span class="gradient-text">Us</span></h2>
                <p class="section-subtitle">What makes our training program stand out</p>
            </div>
            
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-number" data-count="500">0</div>
                    <div class="stat-label">Students Trained</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-globe"></i>
                    </div>
                    <div class="stat-number" data-count="100">0</div>
                    <div class="stat-label">Websites Built</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <div class="stat-number" data-count="50">0</div>
                    <div class="stat-label">Industry Projects</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                    <div class="stat-number" data-count="100">0</div>
                    <div class="stat-label">Practical Sessions</div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                    <div class="stat-number" data-count="100">0</div>
                    <div class="stat-label">Career Guidance</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Instructor Section -->
    <section id="instructor" class="instructor section-padding">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Instructor</span>
                <h2 class="section-title">Meet Your <span class="gradient-text">Instructor</span></h2>
                <p class="section-subtitle">Learn from an industry expert with years of experience</p>
            </div>
            
            <div class="instructor-card">
                <div class="instructor-image">
                    <img src="images/instructor.jpg" alt="Kay Daniels - Instructor" />
                    <div class="instructor-social">
                        <a href="#" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#" target="_blank"><i class="fab fa-github"></i></a>
                        <a href="#" target="_blank"><i class="fab fa-twitter"></i></a>
                        <a href="#" target="_blank"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
                <div class="instructor-info">
                    <h3 class="instructor-name">Kay Daniels</h3>
                    <p class="instructor-title">Website Developer & Educational Technologist</p>
                    <div class="instructor-specialties">
                        <span class="specialty-tag">
                            <i class="fas fa-code"></i> Website Developer
                        </span>
                        <span class="specialty-tag">
                            <i class="fas fa-graduation-cap"></i> Moodle Specialist
                        </span>
                        <span class="specialty-tag">
                            <i class="fas fa-brain"></i> AI Trainer
                        </span>
                        <span class="specialty-tag">
                            <i class="fas fa-chalkboard"></i> Educational Technologist
                        </span>
                    </div>
                    <p class="instructor-bio">
                        With over 10 years of experience in web development and educational technology, 
                        Kay Daniels has trained over 500 students across Nigeria. He specializes in making 
                        complex concepts accessible and practical, ensuring students become job-ready 
                        within weeks.
                    </p>
                    <div class="instructor-stats">
                        <div class="stat-item">
                            <span class="stat-number">10+</span>
                            <span class="stat-label">Years Experience</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">500+</span>
                            <span class="stat-label">Students</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number">100+</span>
                            <span class="stat-label">Projects</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="testimonials section-padding" style="background: var(--light);">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Testimonials</span>
                <h2 class="section-title">What Students <span class="gradient-text">Say</span></h2>
                <p class="section-subtitle">Real experiences from our graduates</p>
            </div>
            
            <div class="testimonial-carousel">
                <div class="testimonial-track">
                    <!-- Testimonial 1 -->
                    <div class="testimonial-card">
                        <div class="testimonial-stars">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <p class="testimonial-text">
                            "The Holiday IT Coaching transformed my life. I went from knowing nothing about coding to building my own website in just 3 weeks!"
                        </p>
                        <div class="testimonial-author">
                            <img src="https://ui-avatars.com/api/?name=John+Doe&background=0056D2&color=fff" alt="Student" />
